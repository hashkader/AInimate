# Copy to .env and fill in — required by `npm run server` (see server/index.ts).
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2
PORT=3001

# Used only to estimate the cost shown after each Generate — defaults match
# MiniMax M2's standard-tier rate. Override if your invoiced rate differs.
MINIMAX_INPUT_PRICE_PER_MILLION=0.3
MINIMAX_OUTPUT_PRICE_PER_MILLION=1.2
